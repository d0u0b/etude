{
  "name": "Piano Page Turner",
  "short_name": "琴譜練習",
  "description": "看 PDF 樂譜用踏板翻頁，彈課本練習題標出彈對彈錯",
  "lang": "zh-Hant",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
