  "theme_color": "#efe4dd",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "練習模式", "short_name": "練習", "url": "practice.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "彈奏模式", "short_name": "彈奏", "url": "play.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "MIDI 測試", "short_name": "MIDI", "url": "midi-test.html", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
